
CC = gcc
CFLAGS = -Wall -Wextra -std=c11
TARGET = calculator_dynamic.exe
SRC = Module2.3.c

all: $(TARGET)

$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC)

run: $(TARGET)
	./$(TARGET)

clean:
	@if exist $(TARGET) del /Q $(TARGET)

rebuild: clean all

.PHONY: all run clean rebuild
