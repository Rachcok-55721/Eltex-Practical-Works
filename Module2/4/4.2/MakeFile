
CC = gcc
CFLAGS = -Wall -Wextra -std=c11
TARGET = priority_queue.exe
SRC = Module4.2.c


all: $(TARGET)


$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC)


run: $(TARGET)
	.\$(TARGET)


clean:
	-del /Q $(TARGET) 2>NUL


rebuild: clean all

.PHONY: all run clean rebuild
